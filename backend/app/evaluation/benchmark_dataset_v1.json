      "has_live_frame": false,
      "expected_intent": "follow_up",
      "expected_in_answer": ["quantum"],
      "forbidden_in_answer": ["configuration management", "it department"],
      "must_pass_grounding": true
    },
    {
      "id": "tc_04_topic_shift_prevention",
