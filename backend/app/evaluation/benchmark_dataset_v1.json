        {"role": "ai", "content": "Camera snapshot captured and saved."}
      ],
      "has_live_frame": false,
      "expected_intent": "factual_knowledge",
      "expected_in_answer": ["photosynthesis", "plant", "light"],
      "forbidden_in_answer": ["snapshot", "saved to disk"],
      "must_pass_grounding": true
    },
    {
      "id": "tc_05_offline_camera_grounding",
