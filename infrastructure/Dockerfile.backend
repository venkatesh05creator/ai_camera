# Production Dockerfile for Full-Stack AI Surveillance Backend
FROM python:3.11-slim

# System dependencies for OpenCV, FFmpeg, and cryptography
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    fastapi uvicorn sqlalchemy psycopg2-binary redis argon2-cffi cryptography pyjwt email-validator

# Copy source code and pre-trained weights
COPY backend/ ./backend/
COPY models/ ./models/
COPY datastore/ ./datastore/

# Create persistent storage directories
RUN mkdir -p /app/var/media /app/var/snapshots /app/var/logs

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
