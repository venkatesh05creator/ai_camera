# ---------------------------------------------------------------------------
# Example environment file for the Owner-Only AI Camera Assistant.
#
# Copy this file to ".env" and fill in the values.  ".env" is ignored by git.
# Every value below is a PLACEHOLDER - never commit a real secret.
#
#   cp .env.example .env
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
OWNERAI_APP_ENV=development              # development | test | production
OWNERAI_DEBUG=false
OWNERAI_LOG_LEVEL=INFO
OWNERAI_JSON_LOGS=true

# --- Secrets (server side only, never exposed to a browser) ---------------
# Required in production, minimum 32 characters.
OWNERAI_SECRET_KEY=replace-with-a-long-random-value-at-least-32-characters
# Encrypts biometric templates and stored contact addresses (AES-256-GCM).
OWNERAI_BIOMETRIC_ENCRYPTION_KEY=replace-with-a-different-long-random-value
# Optional: server-side key for an OpenAI compatible assistant.
OWNERAI_AI_API_KEY=

# --- Storage --------------------------------------------------------------
# SQLite by default.  Use a server database URL for multi-worker setups.
OWNERAI_DATABASE_URL=sqlite:///./var/ownerai.db
OWNERAI_DB_ECHO=false
OWNERAI_SQL_ECHO=false

# --- Sessions and cookies -------------------------------------------------
OWNERAI_SESSION_COOKIE_NAME=ownerai_session
OWNERAI_CSRF_COOKIE_NAME=ownerai_csrf
OWNERAI_COOKIE_SAMESITE=lax              # lax | strict | none (none requires HTTPS)
OWNERAI_SESSION_IDLE_MINUTES=30
OWNERAI_SESSION_ABSOLUTE_MINUTES=720
OWNERAI_REMEMBER_ME_DAYS=30
OWNERAI_PASSWORD_MIN_LENGTH=12

# --- Transport hardening --------------------------------------------------
# Both must be true in production.
OWNERAI_HTTPS_ONLY=false
OWNERAI_HSTS_ENABLED=false
OWNERAI_HSTS_MAX_AGE=31536000
OWNERAI_HSTS_INCLUDE_SUBDOMAINS=true
# Comma separated list of host names the server answers to.
OWNERAI_TRUSTED_HOSTS=localhost,127.0.0.1
# Comma separated list of allowed CORS origins (empty = no CORS at all).
OWNERAI_CORS_ORIGINS=
# Only enable when a reverse proxy sets X-Forwarded-Proto / X-Forwarded-For.
OWNERAI_TRUST_PROXY_HEADERS=false

# --- Rate limits ----------------------------------------------------------
OWNERAI_RATE_LIMIT_ENABLED=true
OWNERAI_LOGIN_RATE_LIMIT=5
OWNERAI_LOGIN_RATE_WINDOW_SECONDS=300
OWNERAI_REGISTER_RATE_LIMIT=3
OWNERAI_REGISTER_RATE_WINDOW_SECONDS=3600
OWNERAI_PASSWORD_RESET_RATE_LIMIT=3
OWNERAI_PASSWORD_RESET_RATE_WINDOW_SECONDS=3600
OWNERAI_SEARCH_RATE_LIMIT=30
OWNERAI_SEARCH_RATE_WINDOW_SECONDS=60
OWNERAI_AI_RATE_LIMIT=20
OWNERAI_AI_RATE_WINDOW_SECONDS=60
OWNERAI_CONTACT_RATE_LIMIT=3
OWNERAI_CONTACT_RATE_WINDOW_SECONDS=3600

# --- Request limits -------------------------------------------------------
OWNERAI_MAX_REQUEST_BODY_BYTES=8388608
OWNERAI_MAX_UPLOAD_BYTES=5242880
OWNERAI_MAX_PAGE_SIZE=100
OWNERAI_DEFAULT_PAGE_SIZE=25

# --- E-mail ---------------------------------------------------------------
# console | smtp | null
OWNERAI_MAILER_BACKEND=console
OWNERAI_MAILER_FROM=no-reply@localhost
# The address shown in the contact form (optional).
OWNERAI_SUPPORT_DESTINATION=
OWNERAI_SMTP_HOST=
OWNERAI_SMTP_PORT=587
OWNERAI_SMTP_USERNAME=
OWNERAI_SMTP_PASSWORD=
OWNERAI_SMTP_USE_TLS=true
OWNERAI_REQUIRE_EMAIL_VERIFICATION=false
OWNERAI_EMAIL_TOKEN_TTL_MINUTES=60

# --- Multi-factor authentication ------------------------------------------
OWNERAI_MFA_REQUIRED_FOR_ADMIN=true
OWNERAI_TOTP_ISSUER=Owner-Only AI Camera Assistant
OWNERAI_TOTP_STEP_SECONDS=30
OWNERAI_TOTP_WINDOW=1

# --- Biometrics -----------------------------------------------------------
OWNERAI_BIOMETRICS_ENABLED=true
OWNERAI_BIOMETRIC_RETENTION_DAYS=90
OWNERAI_FACE_MATCH_THRESHOLD=0.72
OWNERAI_ENROLLMENT_MAX_IMAGES=5

# --- Cameras --------------------------------------------------------------
# Hosts that may resolve to private addresses (development only!).
OWNERAI_ALLOW_PRIVATE_CAMERA_HOSTS=
OWNERAI_CAMERA_FETCH_TIMEOUT_SECONDS=8
OWNERAI_CAMERA_MAX_BYTES=4194304
OWNERAI_CAMERA_MAX_REDIRECTS=2
OWNERAI_DEVICE_TOKEN_TTL_SECONDS=300

# --- AI provider ----------------------------------------------------------
# offline | openai_compatible
OWNERAI_AI_PROVIDER=offline
OWNERAI_AI_API_BASE=https://api.openai.com/v1
OWNERAI_AI_MODEL=gpt-4o-mini
OWNERAI_AI_TIMEOUT_SECONDS=30
OWNERAI_AI_MAX_OUTPUT_TOKENS=700
OWNERAI_AI_CONTEXT_MAX_CHARS=4000
OWNERAI_AI_DAILY_TOKEN_BUDGET=100000
OWNERAI_AI_DAILY_REQUEST_BUDGET=200
